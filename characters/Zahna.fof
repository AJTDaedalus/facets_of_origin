fof_version: '1.0'
type: character
id: zahna
name: Zahna
version: 2.0.0
authors:
- Zahna
ruleset:
  modules:
  - id: base
    version: 1.0.0

character:
  name: Zahna
  player_name: Zahna
  facet: mind
  level: 1
  class:
    id: thaumaturge
    name: Thaumaturge
    concept: "I am a scholar whose study became a working art."
    custom: false
  stats: {body: 0, mind: 2, soul: 1}
  # HP 6 = Mind grit die maximum 6 + Body 0.
  hp: {max: 6, current: 6}
  knacks: ["Arcane theory", "Guild Apprentice"]   # class knack, background knack
  specialty: >
    Deep familiarity with the Artificers' Guild records, technical vocabulary,
    and personnel — and with the circumstances of the Guild's dissolution.
  background:
    id: guild_apprentice
    name: Guild Apprentice
    description: >
      Formally apprenticed at the Thornwall Artificers' Guild. The education
      was rigorous and incomplete in equal measure — the Guild dissolved before
      Zahna finished, leaving him with foundational scholarly training, a
      half-developed magical practice, and more questions than the curriculum
      ever intended to raise.
  lineage: {id: human}
  talents:
  - {id: thaumaturgy, improved: false, choice: inscription}
  - {id: loremaster, improved: false}
  signature: null        # the Thaumaturge's is Arcane Mastery, taken at level 3
  magic:
    tradition: thaumaturgy
    domains: [inscription]
    # Owner review: the two signature workings are new — chosen from the
    # domain's own description, not from established canon.
    signature_workings:
    - "A sealing glyph that holds a door or lid shut until its trigger word"
    - "A warning rune that sounds when something crosses it"
    origin: >
      Trained as an apprentice at the Thornwall Artificers' Guild before the
      Guild dissolved. Developed the Inscription domain through formal guild
      study — encoding effects into runes and glyphs was the first thing that
      made sense to him.
  inventory:
  - {id: staff, name: "Staff", slots: 1, kind: blunt}
  - {id: books, name: "Books and notes", slots: 1}
  - {id: ink_and_chalk, name: "Ink, chalk and paper", slots: 1}
  - {id: light_armor, name: "Light armor", slots: 1}
  - {id: rations, name: "Rations", slots: 1, usage_die: 6}
  equipped: {weapon: staff, armor: light, shield: false}
  coin: 30
  fatigue: 0
  wounds: []
  scars: []
  sparks: 3
  talent_uses: {}
  notes_player: >
    Mind 2, Soul 1, Body 0: reads the world through analysis, not instinct.
    Casts Inscription with Mind; the two signature workings are one step
    Easier. Six HP means he is fragile in a fight and should know it. Soul 1
    is not social grace — it is stubbornness.
  notes_mm: ""

created_at: '2026-03-04T00:00:00+00:00'
last_modified: '2026-09-25T00:00:00+00:00'
