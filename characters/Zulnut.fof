fof_version: '1.0'
type: character
id: zulnut
name: Zulnut
version: 2.0.0
authors:
- Zulnut
ruleset:
  modules:
  - id: base
    version: 1.0.0

character:
  name: Zulnut
  player_name: Zulnut
  facet: body
  level: 1
  class:
    id: wandering_disciple
    name: Wandering Disciple
    concept: >
      I am a disciple of a wandering ascetic tradition — discipline built
      through motion and stillness, and the minimum possible effort.
    custom: true
    talents: [unarmored_discipline, athlete]
    signature: ghost     # the class's level-3 signature, chosen in advance
  stats: {body: 2, mind: 0, soul: 1}
  # HP 12 = Body grit die maximum 10 + Body 2.
  hp: {max: 12, current: 12}
  knacks: ["Motion and stillness", "Sleight of hand and quiet feet"]   # class knack, background knack
  specialty: >
    Trained to notice the exact moment a room's attention shifts — the
    half-second window when a mark stops watching their own back. Knows how to
    be unremarkable at precisely the moment it matters.
  background:
    id: wandering_disciple
    name: Wandering Disciple
    custom: true
    description: >
      You trained under a wandering ascetic tradition — no temple, no
      institution, just a teacher who moved on and the habits that stayed:
      discipline built through motion, stillness, and reading a room before it
      knows it is being read. Sleight of hand and quiet feet came with the
      life, not the training — a wanderer who wants to eat learns to move
      unnoticed when a situation calls for it.
  lineage: {id: human}
  talents:
  - {id: unarmored_discipline, improved: false}
  - {id: athlete, improved: false}
  signature: null
  magic: null
  inventory:
  - {id: light_weapon, name: "Knife", slots: 1, kind: blades}
  - {id: rope, name: "Rope, 50 ft", slots: 1}
  - {id: rations, name: "Rations", slots: 1, usage_die: 6}
  - {id: torches, name: "Torches", slots: 1, usage_die: 6}
  equipped: {weapon: light_weapon, armor: none, shield: false}
  coin: 20
  fatigue: 0
  wounds: []
  scars: []
  sparks: 3
  talent_uses: {}
  notes_player: >
    Body 2, Soul 1, Mind 0: precise and fortunate, exceptional in exact
    moments, unremarkable everywhere else. No armor and no shield, so
    Unarmored Discipline gives armor 1. Twelve HP and armor 1 is not much in a
    sustained fight, which is intentional — the character's answer to "what
    happens when you take a hit" is "don't."
  notes_mm: ""

