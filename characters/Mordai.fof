fof_version: '1.0'
type: character
id: mordai
name: Mordai
version: 2.0.0
authors:
- Mordai
ruleset:
  modules:
  - id: base
    version: 1.0.0

character:
  name: Mordai
  player_name: Mordai
  facet: body
  level: 1
  class:
    id: warrior
    name: Warrior
    concept: "I am a trained fighter who stands where the fighting is thickest."
    custom: false
  stats: {body: 2, mind: 0, soul: 1}
  # HP 16 = Body grit die maximum 10 + Body 2 + Tough 4.
  hp: {max: 16, current: 16}
  knacks: ["Soldiering", "City Watch Veteran"]   # class knack, background knack
  specialty: >
    Knows the layout, regular occupants, and unofficial rules of Thornwall's
    market district from years of patrol.
  background:
    id: city_watch_veteran
    name: City Watch Veteran
    description: >
      Years of service in a city watch — street patrol, breaking up fights,
      pursuing criminals through crowded markets, and learning that the direct
      approach usually works and sometimes doesn't. Combat technique developed
      from necessity rather than formal training.
  lineage: {id: human}
  talents:
  - {id: weapon_master, improved: false, choice: blades}
  - {id: tough, improved: false}
  signature: null        # the Warrior's is Unstoppable, taken at level 3
  magic: null
  inventory:
  - {id: standard_weapon, name: "Longsword", slots: 1, kind: blades}
  - {id: heavy_armor, name: "Heavy armor", slots: 2}
  - {id: shield, name: "Shield", slots: 1}
  - {id: rope, name: "Rope, 50 ft", slots: 1}
  - {id: rations, name: "Rations", slots: 1, usage_die: 6}
  equipped: {weapon: standard_weapon, armor: heavy, shield: true}
  coin: 40
  fatigue: 0
  wounds: []
  # This file is Mordai at creation, before Millhaven. After the mill-beam
  # scene (PHB III.2) he carries the canon Scar — his shoulder set wrong — and
  # any snapshot of him from that point on records it here.
  scars: []
  sparks: 3
  talent_uses: {}
  notes_player: >
    Body 2, Soul 1, Mind 0: strong, steady, and not a reader of rooms. An
    attack is 2d6 + Body (+1 more when Soldiering applies). The longsword is a
    standard weapon (d8), one size up to d10 with Weapon Master (blades).
    Heavy armor and a shield give armor 3, the cap.
  notes_mm: ""

